# .env.example
# Example environment configuration for the Saskan app
# Copy to `.env` (or `.env.local`, `.env.prod`) and adjust values as needed.

# -----------------------------
# Runtime settings
# -----------------------------
# Application mode: development, testing, staging, production
APP_ENV=development
DEBUG=true

# Secret key for session management / cryptographic uses
# Generate a secure value with: `python -c "import secrets; print(secrets.token_urlsafe(32))"`
SECRET_KEY=changeme-in-production

# -----------------------------
# Database
# -----------------------------
# Default to SQLite for local dev
DATABASE_URL=sqlite:///./saskan_dev.db

# Example PostgreSQL URL format:
# postgresql://USER:PASSWORD@HOST:PORT/DBNAME
# DATABASE_URL=postgresql://saskan_user:changeme@localhost:5432/saskan

# -----------------------------
# API Integrations
# -----------------------------
# OpenAI API key for GPT-powered features
OPENAI_API_KEY=sk-xxxx

# (Add other APIs as needed)
# MAPS_API_KEY=your-key-here
# EMAIL_SMTP_URL=smtp://user:pass@mail.example.com:587

# -----------------------------
# Paths and Misc
# -----------------------------
# Data directory for logs, saves, etc.
DATA_DIR=./data
LOG_LEVEL=INFO
